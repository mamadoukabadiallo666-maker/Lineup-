<!DOCTYPE html><html><head><title>Fil d'actualité</title><meta name="viewport" content="width=device-width, initial-scale=1">
<style>body{margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial;background:#f0f2f5;padding-bottom:60px}
.header{position:sticky;top:0;background:#1877f2;color:white;padding:10px 15px;display:flex;justify-content:space-between;align-items:center;z-index:100}
.header h1{margin:0;font-size:24px;font-weight:800}
.bottom-nav{position:fixed;bottom:0;width:100%;background:white;display:flex;justify-content:space-around;padding:8px 0;border-top:1px solid #ddd}
.bottom-nav a{color:#65676b;text-decoration:none;font-size:24px}
.container{max-width:600px;margin:0 auto;padding:10px}
.create-post{background:white;border-radius:8px;padding:12px;margin-bottom:10px}
.post{background:white;border-radius:8px;padding:12px;margin-bottom:10px}
.actions{display:flex;justify-content:space-around;border-top:1px solid #ddd;padding-top:8px}
</style></head><body>
<div class="header"><h1>Lineup</h1><form action="/search/"><input name="q" placeholder="Rechercher" style="border-radius:20px;border:none;padding:5px 10px"></form><div><a href="{% url 'menu' %}" style="color:white">☰</a><a href="{% url 'notifications' %}" style="color:white">🔔</a><a href="{% url 'messages' %}" style="color:white">💬</a></div></div>

<div class="container">
    <div class="create-post">
        <form method="POST" action="{% url 'create_post' %}" enctype="multipart/form-data">{% csrf_token %}
        <input name="content" placeholder="À quoi pensez-vous, {{user.username}} ?" style="width:90%;border:none;background:#f0f2f5;border-radius:20px;padding:10px">
        <input type="file" name="image"><button>Publier</button></form>
    </div>
    {% for post in posts %}
    <div class="post">
        <b>{{post.user.username}}</b> <span style="color:gray;font-size:12px">{{post.created_at|timesince}}</span>
        <p>{{post.content}}</p>{% if post.image %}<img src="{{post.image.url}}" style="width:100%">{% endif %}
        <div class="actions">
            <a href="{% url 'like_post' post.id %}">👍 J'aime {{post.total_likes}}</a>
            <a href="{% url 'post_detail' post.id %}">💬 Commenter</a>
            <a href="{% url 'share_post' post.id %}">↗ Partager</a>
<a href="{% url 'save_post' post.id %}">💾 Sauvegarder</a>
        </div>
    </div>{% endfor %}
</div>

<div class="bottom-nav">
    <a href="{% url 'home' %}">🏠</a>
    <a href="{% url 'reels' %}">🎬</a>
    <a href="{% url 'marketplace' %}">🛒</a>
    <a href="{% url 'groups_list' %}">👥</a>
    <a href="{% url 'notifications' %}">🔔</a>
</div></body></html>
